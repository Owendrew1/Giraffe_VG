# Giraffe mapping on cactus pangenome graphs (James align_trifolium_reads pattern).
# Per-lane map → merge GAMs → surject → mark duplicates → QC / VCF.
# Run from repo root:
#   ./scripts/run_giraffe.sh 4

configfile: "../config/config.yaml"
include: "rules/common.smk"


rule all:
    input:
        DONE,


rule giraffe_index:
    input:
        pangenome_done=PANGENOME_DONE,
        index_done=INDEX_DONE,
        gbz=lambda wc: graph_input(wc, "gbz"),
    output:
        gbz=f"{IDX}/{{graph_id}}/graph.gbz",
        dist=f"{IDX}/{{graph_id}}/graph.dist",
        min=f"{IDX}/{{graph_id}}/graph.min",
        zipcodes=f"{IDX}/{{graph_id}}/graph.zipcodes",
        done=f"{IDX}/{{graph_id}}/index.done",
    log:
        f"{LOG}/giraffe_index/{{graph_id}}.log",
    params:
        outdir=index_out,
    threads:
        CORES,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        OUTDIR={params.outdir}
        mkdir -p "$OUTDIR"
        ln -sf '{input.gbz}' "$OUTDIR/graph.gbz"
        # Rebuild dist/min with this env's vg — cactus indexes are wrong vg version.
        vg index -t {threads} -j "$OUTDIR/graph.dist" "$OUTDIR/graph.gbz"
        vg minimizer -t {threads} -d "$OUTDIR/graph.dist" -o "$OUTDIR/graph.min" \\
          -z "$OUTDIR/graph.zipcodes" "$OUTDIR/graph.gbz"
        touch "$OUTDIR/index.done"
        """


rule giraffe_map_lane:
    input:
        gbz=rules.giraffe_index.output.gbz,
        dist=rules.giraffe_index.output.dist,
        min=rules.giraffe_index.output.min,
        zipcodes=rules.giraffe_index.output.zipcodes,
        r1=lane_r1,
        r2=lane_r2,
    output:
        gam=temp(f"{WORK}/{{graph_id}}/{{sample_id}}/{{sample_id}}.lane{{lane}}.gam"),
    log:
        f"{LOG}/giraffe_map/{{graph_id}}_{{sample_id}}_lane{{lane}}.log",
    params:
        outdir=work_sample_out,
    threads:
        CORES,
    resources:
        mem_mb=MEM_MB,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        mkdir -p {params.outdir}
        vg giraffe -p -Z '{input.gbz}' -d '{input.dist}' -m '{input.min}' -z '{input.zipcodes}' \\
          -f '{input.r1}' -f '{input.r2}' -t {threads} > '{output.gam}'
        """


rule merge_lane_gams:
    input:
        gams=lambda wc: [
            f"{WORK}/{wc.graph_id}/{wc.sample_id}/{wc.sample_id}.lane{lane}.gam"
            for lane in SAMPLE_LANES[wc.sample_id]
        ],
    output:
        gam=temp(f"{WORK}/{{graph_id}}/{{sample_id}}/{{sample_id}}.merge.gam"),
    log:
        f"{LOG}/merge_lane_gams/{{graph_id}}_{{sample_id}}.log",
    params:
        outdir=work_sample_out,
    threads:
        CORES,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        mkdir -p {params.outdir}
        GAMS=({input.gams})
        if [ "${{#GAMS[@]}}" -eq 1 ]; then
          cp "${{GAMS[0]}}" '{output.gam}'
        else
          cat "${{GAMS[@]}}" > '{output.gam}'
        fi
        """


if WANT_GAM:

    rule retain_merged_gam:
        input:
            gam=rules.merge_lane_gams.output.gam,
        output:
            gam=merged_gam_path,
        shell:
            "cp -a {input.gam} {output.gam}"


rule giraffe_surject:
    input:
        gbz=rules.giraffe_index.output.gbz,
        gam=rules.merge_lane_gams.output.gam,
    output:
        bam=temp(f"{WORK}/{{graph_id}}/{{sample_id}}/{{sample_id}}.surject.bam"),
        bai=temp(f"{WORK}/{{graph_id}}/{{sample_id}}/{{sample_id}}.surject.bam.bai"),
    log:
        f"{LOG}/giraffe_surject/{{graph_id}}_{{sample_id}}.log",
    params:
        outdir=work_sample_out,
        read_group=surject_read_group,
    threads:
        CORES,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        mkdir -p {params.outdir}
        vg surject -t {threads} -x '{input.gbz}' -b \\
          -N {wildcards.sample_id} -R "{params.read_group}" \\
          '{input.gam}' | samtools sort -@ {threads} -o '{output.bam}'
        samtools index -@ {threads} '{output.bam}'
        """


rule mark_duplicates:
    input:
        bam=rules.giraffe_surject.output.bam,
        bai=rules.giraffe_surject.output.bai,
    output:
        bam=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.markdup.bam",
        bai=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.markdup.bam.bai",
        metrics=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.markdup.metrics.txt",
    log:
        f"{LOG}/mark_duplicates/{{graph_id}}_{{sample_id}}.log",
    threads:
        4,
    resources:
        mem_mb=MEM_MB,
    params:
        java_opts=lambda wc, resources: f"-Xmx{int(resources.mem_mb * 0.85)}m",
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        gatk --java-options "{params.java_opts}" MarkDuplicates \\
          -I {input.bam} \\
          -O {output.bam} \\
          -M {output.metrics} \\
          --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500 \\
          --VALIDATION_STRINGENCY SILENT
        samtools index -@ {threads} {output.bam}
        """


rule qc_flagstat:
    input:
        bam=rules.mark_duplicates.output.bam,
        bai=rules.mark_duplicates.output.bai,
    output:
        f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.flagstat.txt",
    log:
        f"{LOG}/qc_flagstat/{{graph_id}}_{{sample_id}}.log",
    conda:
        CONDA,
    shell:
        "samtools flagstat {input.bam} > {output} 2> {log}"


rule qc_mosdepth:
    input:
        bam=rules.mark_duplicates.output.bam,
        bai=rules.mark_duplicates.output.bai,
    output:
        summary=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.mosdepth.summary.txt",
        dist=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.mosdepth.global.dist.txt",
    log:
        f"{LOG}/qc_mosdepth/{{graph_id}}_{{sample_id}}.log",
    params:
        prefix=lambda wc: f"{RES}/{wc.graph_id}/{wc.sample_id}/{wc.sample_id}",
    threads:
        4,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        mosdepth -t {threads} -n --fast-mode {params.prefix} {input.bam} 2> {log}
        """


rule qc_vg_stats:
    input:
        gbz=rules.giraffe_index.output.gbz,
        gam=rules.merge_lane_gams.output.gam,
    output:
        f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.vg_stats.txt",
    log:
        f"{LOG}/qc_vg_stats/{{graph_id}}_{{sample_id}}.log",
    conda:
        CONDA,
    shell:
        "vg stats -z {input.gbz} -a '{input.gam}' > {output} 2> {log}"


rule vg_variant_call:
    input:
        gbz=rules.giraffe_index.output.gbz,
        gam=rules.merge_lane_gams.output.gam,
        ref=ref_path_for_graph,
    output:
        vcf=temp(f"{WORK}/{{graph_id}}/{{sample_id}}/{{sample_id}}.vg_call.vcf.gz"),
        tbi=temp(f"{WORK}/{{graph_id}}/{{sample_id}}/{{sample_id}}.vg_call.vcf.gz.tbi"),
    log:
        f"{LOG}/vg_variant_call/{{graph_id}}_{{sample_id}}.log",
    threads:
        CORES,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        WRK=$(mktemp -d)
        trap 'rm -rf "$WRK"' EXIT
        vg snarls '{input.gbz}' > "$WRK/snarls.snarls"
        vg pack -x '{input.gbz}' -g '{input.gam}' -o "$WRK/pack.gz" -t {threads}
        vg call '{input.gbz}' -k "$WRK/pack.gz" -r "$WRK/snarls.snarls" -a \\
          -f '{input.ref}' -t {threads} | bgzip -c > '{output.vcf}'
        tabix -f -p vcf '{output.vcf}'
        """


rule filter_vg_vcf:
    input:
        vcf=rules.vg_variant_call.output.vcf,
        tbi=rules.vg_variant_call.output.tbi,
    output:
        vcf=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.vg_call.filtered.vcf.gz",
        tbi=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.vg_call.filtered.vcf.gz.tbi",
    log:
        f"{LOG}/filter_vg_vcf/{{graph_id}}_{{sample_id}}.log",
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        # Basic QUAL filter; tighten once we have real call-set stats.
        bcftools filter -e 'QUAL<20' -Oz -o {output.vcf} {input.vcf} 2> {log}
        tabix -f -p vcf {output.vcf}
        """


rule qc_vcf_stats:
    input:
        vcf=rules.filter_vg_vcf.output.vcf,
        tbi=rules.filter_vg_vcf.output.tbi,
    output:
        f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.vg_call.filtered.bcftools_stats.txt",
    log:
        f"{LOG}/qc_vcf_stats/{{graph_id}}_{{sample_id}}.log",
    conda:
        CONDA,
    shell:
        "bcftools stats {input.vcf} > {output} 2> {log}"


rule small_variant_call:
    input:
        bam=rules.mark_duplicates.output.bam,
        bai=rules.mark_duplicates.output.bai,
        ref=ref_path_for_graph,
    output:
        vcf=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.small_variants.vcf.gz",
        tbi=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.small_variants.vcf.gz.tbi",
    log:
        f"{LOG}/small_variant_call/{{graph_id}}_{{sample_id}}.log",
    params:
        sample=lambda wc: wc.sample_id,
    threads:
        CORES,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        gatk HaplotypeCaller \\
          -R {input.ref} \\
          -I {input.bam} \\
          -O {output.vcf} \\
          --sample-name {params.sample} \\
          --native-pair-hmm-threads {threads} \\
          2> {log}
        tabix -f -p vcf {output.vcf}
        """


rule sv_regions:
    input:
        bam=rules.mark_duplicates.output.bam,
        small_vcf=rules.small_variant_call.output.vcf,
        vg_vcf=rules.filter_vg_vcf.output.vcf,
    output:
        tsv=f"{RES}/{{graph_id}}/{{sample_id}}/{{sample_id}}.sv_regions.tsv",
    log:
        f"{LOG}/sv_regions/{{graph_id}}_{{sample_id}}.log",
    params:
        outdir=regions_out,
    conda:
        CONDA,
    shell:
        """
        set -euo pipefail
        exec > >(tee -a {log}) 2>&1
        mkdir -p {params.outdir} $(dirname {output.tsv})
        echo -e "region_id\\tchrom\\tstart\\tend\\tmean_depth\\tmapped_reads\\tmean_mapq\\tsmall_variant_count\\tvg_call_variant_count" > {output.tsv}
        while IFS= read -r line || [[ -n "$line" ]]; do
          [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
          [[ "$line" =~ ^([^:]+):([0-9]+)-([0-9]+)$ ]] || {{ echo "Bad region: $line" >&2; exit 1; }}
          chrom="${{BASH_REMATCH[1]}}"
          start="${{BASH_REMATCH[2]}}"
          end="${{BASH_REMATCH[3]}}"
          coords="${{chrom}}:${{start}}-${{end}}"
          region_id="${{chrom}}_${{start}}_${{end}}"
          region_id="${{region_id//./_}}"
          locus_dir="{params.outdir}/$region_id"
          mkdir -p "$locus_dir"
          samtools view -b -r "$coords" -o "$locus_dir/$region_id.bam" {input.bam}
          bcftools view -r "$coords" -Oz -o "$locus_dir/$region_id.small_variants.vcf.gz" {input.small_vcf}
          bcftools view -r "$coords" -Oz -o "$locus_dir/$region_id.vg_call.vcf.gz" {input.vg_vcf}
          mean_depth="$(samtools depth -r "$coords" {input.bam} | awk '{{s+=$3;n++}} END {{if(n>0) printf "%.2f", s/n; else print "0"}}')"
          mapped_reads="$(samtools view -c -r "$coords" {input.bam})"
          mean_mapq="$(samtools view -r "$coords" {input.bam} | awk '{{s+=$5;n++}} END {{if(n>0) printf "%.2f", s/n; else print "0"}}')"
          small_n="$(bcftools view -H -r "$coords" "$locus_dir/$region_id.small_variants.vcf.gz" | wc -l | tr -d ' ')"
          vg_n="$(bcftools view -H -r "$coords" "$locus_dir/$region_id.vg_call.vcf.gz" | wc -l | tr -d ' ')"
          echo -e "${{region_id}}\\t${{chrom}}\\t${{start}}\\t${{end}}\\t${{mean_depth}}\\t${{mapped_reads}}\\t${{mean_mapq}}\\t${{small_n}}\\t${{vg_n}}" >> {output.tsv}
        done < {REGIONS_FILE}
        """


rule giraffe_done:
    input:
        done_inputs,
    output:
        DONE,
    shell:
        "touch {output}"
